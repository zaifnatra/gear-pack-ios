# Supabase — EXPO_PUBLIC_ vars are bundled into the app (the anon key is safe to ship).
# Copy this file to .env and fill in your project's values.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Next.js /api/v1 backend the app calls (Phase 1).
EXPO_PUBLIC_API_URL=https://gear-pack.vercel.app
